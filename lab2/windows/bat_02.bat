@echo off
rem ============================================================
rem  bat_02 - имя текущего bat-файла, время модификации
rem  и полный путь через расширения параметров
rem ============================================================

set SCRIPT=%~f0
set NAME=%~n0

echo === bat_02: параметры скрипта ===
echo Имя файла: %NAME%
for %%F in ("%SCRIPT%") do echo Изменён: %%~tF
echo Полный путь: %SCRIPT%
echo Расширение: %~x1
