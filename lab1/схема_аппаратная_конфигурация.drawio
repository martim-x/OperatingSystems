<mxfile host="app.diagrams.net" agent="opencode" version="24.7.6">
  <diagram id="lab1-bus-arch" name="Схема аппаратной конфигурации">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="frame" value="&lt;b&gt;Виртуальная машина VMware Fusion&lt;/b&gt;&lt;br&gt;хост: Apple MacBook Pro, процессор Apple M1 Pro (ARM64)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#90a3bf;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#2c3e50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="980" height="800" as="geometry"/>
        </mxCell>

        <mxCell id="cpu" value="&lt;b&gt;ЦП&lt;/b&gt; - центральный процессор&lt;br&gt;Apple Part 000 r0p0 (ARM64)&lt;br&gt;ядер / потоков: 4 / 4&lt;br&gt;базовая частота: 2000 МГц&lt;br&gt;кэш: L1 4×192 КБ (инстр.) / 4×128 КБ (данные)&lt;br&gt;L3 интегрированный: 4×12 МБ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#2c3e50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="380" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="ram" value="&lt;b&gt;ОЗУ&lt;/b&gt; - оперативная память&lt;br&gt;8192 МиБ (8 ГиБ) выделено ВМ&lt;br&gt;видимо в гостевой системе: 7680 МиБ&lt;br&gt;тип: SDRAM (VMware Virtual RAM)&lt;br&gt;слоты: 4 × (4 ГБ + 2 ГБ + 1 ГБ + 512 МБ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#2c3e50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="70" width="380" height="150" as="geometry"/>
        </mxCell>

        <!-- Три шины системной магистрали -->
        <mxCell id="bus_addr" value="&lt;b&gt;ШИНА АДРЕСОВ&lt;/b&gt; — однонаправленная: ЦП → память и устройства (передаёт адреса ячеек)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F57F17;strokeColor=#E65100;strokeWidth=1;verticalAlign=middle;align=center;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="252" width="960" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="bus_data" value="&lt;b&gt;ШИНА ДАННЫХ&lt;/b&gt; — двунаправленная: ЦП ↔ память и устройства (передаёт данные)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=1;verticalAlign=middle;align=center;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="304" width="960" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="bus_ctrl" value="&lt;b&gt;ШИНА УПРАВЛЕНИЯ&lt;/b&gt; — команды чтения/записи, тактирование, подтверждения" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=1;verticalAlign=middle;align=center;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="356" width="960" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="gpu" value="&lt;b&gt;Видеоадаптер&lt;/b&gt;&lt;br&gt;VMware SVGA 3D (VMware, Inc.)&lt;br&gt;ОЗУ адаптера: 1 МиБ (1 048 576 байт)&lt;br&gt;драйвер: vm3dum64_loader.dIl (9.17.6.5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#2c3e50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="300" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="nvme" value="&lt;b&gt;Накопитель постоянной памяти&lt;/b&gt;&lt;br&gt;виртуальный NVMe, 100 ГиБ&lt;br&gt;контроллер: VMware NVMe SSD Controller" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#2c3e50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="450" width="300" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="net" value="&lt;b&gt;Сетевой адаптер&lt;/b&gt;&lt;br&gt;VMware Ethernet (NAT)&lt;br&gt;контроллер: VMware VMXNET3 Ethernet Controller&lt;br&gt;1 Гбит/с" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#2c3e50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="450" width="300" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="busnote" value="Системная магистраль = шина адресов + шина данных + шина управления.&lt;br&gt;Реализация в ВМ: PCI Express (эмуляция VMware) — VMware PCI Express Root Port." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eff6;strokeColor=#cbd5e0;strokeWidth=1;verticalAlign=middle;align=center;fontColor=#2c3e50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="920" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="monitor" value="&lt;b&gt;Монитор (виртуальный)&lt;/b&gt;&lt;br&gt;разрешение: 4112 × 2580 × 60 Гц" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eff6;strokeColor=#cbd5e0;strokeWidth=1;verticalAlign=middle;align=center;fontColor=#2c3e50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="volumes" value="&lt;b&gt;Логические тома диска&lt;/b&gt;&lt;br&gt;EFI 200 МиБ | MSR 16 МиБ&lt;br&gt;Recovery 714 МиБ&lt;br&gt;C: ~83 ГиБ (NTFS, BitLocker) | swap 2 ГиБ | root 14,78 ГиБ (ext4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eff6;strokeColor=#cbd5e0;strokeWidth=1;verticalAlign=middle;align=center;fontColor=#2c3e50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="660" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="netnat" value="&lt;b&gt;Виртуальная сеть VMware (NAT)&lt;/b&gt;&lt;br&gt;подключение к хост-сети MacBook" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eff6;strokeColor=#cbd5e0;strokeWidth=1;verticalAlign=middle;align=center;fontColor=#2c3e50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="660" width="300" height="70" as="geometry"/>
        </mxCell>

        <!-- Отводы от ЦП к магистрали -->
        <mxCell id="e-cpu-addr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E65100;strokeWidth=2;endArrow=block;endFill=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.22;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cpu" target="bus_addr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cpu-data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0D47A1;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.22;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cpu" target="bus_data">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cpu-ctrl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B5E20;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.22;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cpu" target="bus_ctrl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Отводы от ОЗУ к магистрали -->
        <mxCell id="e-ram-addr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E65100;strokeWidth=2;endArrow=block;endFill=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.78;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ram" target="bus_addr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ram-data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0D47A1;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.78;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ram" target="bus_data">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ram-ctrl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B5E20;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.78;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ram" target="bus_ctrl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Отводы от магистрали к устройствам -->
        <mxCell id="e-bus-gpu" value="PCI Express" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3563e9;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.177;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#90a3bf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bus_data" target="gpu">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-bus-nvme" value="PCI Express" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3563e9;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#90a3bf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bus_data" target="nvme">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-bus-net" value="PCI Express" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3563e9;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.823;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#90a3bf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bus_data" target="net">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-gpu-monitor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a3bf;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gpu" target="monitor">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-nvme-volumes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a3bf;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="nvme" target="volumes">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-net-nat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a3bf;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="net" target="netnat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
