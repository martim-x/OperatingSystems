# ---------------------------------------------------------------------------
# Universal .gitignore для учебных репозиториев (labs / lectures)
# ---------------------------------------------------------------------------

# === macOS ===
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.DocumentRevisions-V100
Icon?

# === Windows ===
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# === Linux ===
.directory
.Trash-*
.nfs*

# === Редакторы и IDE ===
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.ipr
*.iws
.fleet/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.swp
*.swo
*~
.netrwhist
tags
.claude/

# === Секреты и локальные настройки ===
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
.netrc

